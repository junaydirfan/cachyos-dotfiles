{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/custom_logo.txt",
    "position": "top",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;230;230;230",
      "3": "38;2;204;204;204",
      "4": "38;2;179;179;179",
      "5": "38;2;153;153;153",
      "6": "38;2;110;110;110"
    },
    "padding": { "top": 1, "left": 1, "right": 0 }
  },
  "display": {
    "separator": " -> ",
    "color": { "keys": "38;2;204;204;204", "title": "38;2;255;255;255", "separator": "38;2;110;110;110" },
    "percent": { "color": { "green": "38;2;255;255;255" } }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "38;2;110;110;110" },

    { "type": "os", "key": " OS", "keyColor": "38;2;255;255;255", "format": "{name}" },
    { "type": "kernel", "key": "├─" },
    { "type": "packages", "key": "├─󰏖" },
    { "type": "shell", "key": "├─" },
    { "type": "uptime", "key": "└─󰔟" },
    "break",

    { "type": "de", "key": " DE/WM", "keyColor": "38;2;255;255;255" },
    { "type": "wm", "key": "├─" },
    { "type": "wmtheme", "key": "├─󰉼" },
    { "type": "icons", "key": "├─󰀻" },
    { "type": "terminal", "key": "└─" },
    "break",

    { "type": "host", "key": "󰌢 PC", "keyColor": "38;2;255;255;255" },
    { "type": "cpu", "key": "├─" },
    { "type": "gpu", "key": "├─󰢮" },
    { "type": "display", "key": "├─󰍹" },
    { "type": "disk", "key": "├─󰋊" },
    { "type": "memory", "key": "└─" },
    "break",

    { "type": "custom", "format": "{#38;2;255;255;255}████{#38;2;230;230;230}████{#38;2;204;204;204}████{#38;2;179;179;179}████{#38;2;153;153;153}████{#38;2;110;110;110}████" }
  ]
}
